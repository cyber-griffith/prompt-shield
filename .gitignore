# --- Secrets -----------------------------------------------------------
# The adjudicator reads ANTHROPIC_API_KEY from the environment. Nothing
# holding a credential belongs in the repo, including local overrides.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtualenvs -------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Test & type-check caches ------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Benchmark output --------------------------------------------------
# Result files are run artifacts, not source. Commit them deliberately
# (e.g. a dated results/ dir) rather than letting stray runs land in git.
*.results.json
/fast.json
/deep.json

# --- Editors & OS ------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
